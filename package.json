{
  "name": "cv",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.0.0"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "prepare": "husky",
    "dev": "astro dev",
    "preview": "astro preview",
    "paper:generate": "node scripts/gen-paper-css.ts && biome format --write src/styles/paper.generated.css",
    "check": "astro check",
    "build": "astro build",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "test": "vitest run",
    "verify:static": "npm run check && npm run lint && npm run format:check && npm run build",
    "verify:commit": "npm run check && npm run lint && npm run format:check && npm test",
    "verify": "npm run verify:commit && npm run build"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.5",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-table": "2.0.0",
    "micromark-extension-gfm-table": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "9.1.7",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
